node {

    docker.image('node:16-buster-slim').inside('-p 3000:3000') {
        stage('Checkout') {
            checkout scm
        }

    stage('Build') {
        sh '''
            npm install
            npm run build 2>&1 | tee build.log
        '''
    }

    stage('Test') {
        sh '''
            npm test -- --watchAll=false 2>&1 | tee test.log
        '''
    }

    stage('Manual Approval') {
        timeout(time: 5, unit: 'MINUTES') {
            input id: 'DeployApproval', message: 'Lanjutkan ke tahap Deploy?', ok: 'Proceed'
        }
    }

    stage('Deploy') {
        sh '''
            set +e
            docker rm -f "$APP_CONTAINER" >/dev/null 2>&1
            set -e

            docker build -t "$APP_IMAGE" -f Dockerfile.app . 2>&1 | tee deploy.log
            docker run -d --name "$APP_CONTAINER" -p 3000:80 "$APP_IMAGE" 2>&1 | tee -a deploy.log
            echo "React App running on http://localhost:3000 for 60 seconds." | tee -a deploy.log
            sleep 60
            docker logs "$APP_CONTAINER" 2>&1 | tee -a deploy.log || true
            docker rm -f "$APP_CONTAINER" 2>&1 | tee -a deploy.log
            echo "Deploy stage finished successfully after 60 seconds." | tee -a deploy.log
        '''
    }

    stage('Archive') {
        sh '''
            {
              echo "=== Build Log ==="
              cat build.log
              echo
              echo "=== Test Log ==="
              cat test.log
              echo
              echo "=== Deploy Log ==="
              cat deploy.log
            } > log.txt
        '''
        archiveArtifacts artifacts: 'log.txt', fingerprint: true
    }
    }

}
