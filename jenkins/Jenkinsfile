node {
    env.CI = 'true'
    env.NODE_OPTIONS = '--openssl-legacy-provider'

    stage('Checkout') {
        checkout scm
    }

    stage('Build') {
        sh '''
            npm install
            npm run build 2>&1 | tee build.log
        '''
    }

    stage('Test') {
        sh '''
            npm test -- --watchAll=false 2>&1 | tee test.log
        '''
    }

    stage('Archive') {
        sh '''
            {
              echo "=== Build Log ==="
              cat build.log
              echo
              echo "=== Test Log ==="
              cat test.log
            } > log.txt
        '''
        archiveArtifacts artifacts: 'log.txt', fingerprint: true
    }
}
